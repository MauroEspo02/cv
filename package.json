{
  "name": "mauroesposito-cv",
  "version": "1.0.0",
  "private": true,
  "description": "Sito portfolio di Mauro Esposito con pannello di amministrazione per modificare i contenuti, su Cloudflare Pages + D1.",
  "scripts": {
    "dev": "wrangler pages dev public --persist-to=.wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply cv-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cv-db --remote",
    "db:seed:regen": "node scripts/generate-seed.js",
    "deploy": "wrangler pages deploy public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "wrangler": "^4.134.0"
  }
}
